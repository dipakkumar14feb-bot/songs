# Sonora AI Music Streaming Configuration

# GEMINI_API_KEY: Required for Gemini AI Playlist & Music Assistant capabilities
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: Public URL of the app
APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL with Prisma ORM)
DATABASE_URL="postgresql://user:password@localhost:5432/sonora_music?schema=public"

# Cloud Object Storage (S3 / Cloudflare R2 / Supabase Storage / Vercel Blob)
STORAGE_PROVIDER="local" # Options: local | s3 | r2 | supabase | blob
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_BUCKET="sonora-audio-vault"
STORAGE_ACCESS_KEY="your-storage-access-key"
STORAGE_SECRET_KEY="your-storage-secret-key"
STORAGE_PUBLIC_URL="https://cdn.sonora.audio"

# Authentication Secret
AUTH_SECRET="super-secret-jwt-key-change-in-production"
AUTH_ADMIN_EMAIL="admin@vibewave.io"
